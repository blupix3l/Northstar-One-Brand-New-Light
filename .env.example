# NorthStar Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit the actual .env file!

# Search provider: "duckduckgo" (default, no key needed) or "brave"
NS_SEARCH_PROVIDER=duckduckgo

# Firecrawl API key (for content enrichment)
# Get one at https://www.firecrawl.dev/
# FIRECRAWL_API_KEY=fc-...
