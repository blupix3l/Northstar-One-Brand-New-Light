# Northstar One - Brand New Light
# Copy this file to .env and fill in your keys.
# NEVER commit the actual .env file!
#
# NOTE: .env is read by experimental_search/northstar_search.py when it is
# imported. The main browser process reads NS_DEBUG from the real
# environment at startup, so NS_DEBUG must be exported in your shell
# (e.g. `set NS_DEBUG=1`) rather than set here.

# Debug logging for the search/discovery subsystem.
# NS_DEBUG=1

# Firecrawl API key - used by the content-enrichment provider.
# Get one at https://www.firecrawl.dev/
# FIRECRAWL_API_KEY=fc-...

# Brave Search API key - used by the experimental Brave search provider.
# No UI field exists for this yet; it has to be set here.
# BRAVE_SEARCH_API_KEY=

# SerpAPI key - alternative provider in the experimental search stack.
# SERPAPI_API_KEY=
